# 生产环境：只在打包时使用
NODE_ENV=production

VITE_DEV=false

# 请求路径
VITE_BASE_URL='https://xmindclub.com'

# 文件上传类型：server - 后端上传， client - 前端直连上传，仅支持S3服务
VITE_UPLOAD_TYPE=server

# 接口地址
VITE_API_URL=

# 是否删除debugger
VITE_DROP_DEBUGGER=true

# 是否删除console.log
VITE_DROP_CONSOLE=true

# 是否sourcemap
VITE_SOURCEMAP=false

# 打包路径
VITE_BASE_PATH=/

# 当前版本
VITE_BUILD_VERSION = 1.2.6

# 文件的oss地址
VITE_APP_OSS_PATH ='https://img.xmindclub.com/'

# 图片的文件地址
VITE_APP_OSS_PIC_PATH = 'https://img.xmindclub.com/'

# 移动端当前版本
VITE_MOBILE_BUILD_VERSION= 0.0.0

# 移动端应用标题
VITE_MOBILE_APP_TITLE='Kaka AI Mobile'
