# 本地开发环境：本地启动所有项目（前端、后端、APP）时使用，不依赖外部环境
NODE_ENV=development

VITE_DEV=true

# 请求路径
VITE_BASE_URL='http://192.168.1.11:8080'

# 文件上传类型：server - 后端上传， client - 前端直连上传，仅支持 S3 服务
VITE_UPLOAD_TYPE=server

# 接口地址
VITE_API_URL=

# 是否删除debugger
VITE_DROP_DEBUGGER=false

# 是否删除console.log
VITE_DROP_CONSOLE=false

# 是否sourcemap
VITE_SOURCEMAP=false

# 打包路径
VITE_BASE_PATH=/

# 当前版本
VITE_BUILD_VERSION = 1.3.6

# 文件的oss地址
VITE_APP_OSS_PATH ='https://pic2.candychat.link/'

# 图片的文件地址
VITE_APP_OSS_PIC_PATH = 'https://pic3.candychat.link/'

# 移动端当前版本
VITE_MOBILE_BUILD_VERSION= 0.0.0

# 移动端应用标题
VITE_MOBILE_APP_TITLE='Kaka AI Mobile'
